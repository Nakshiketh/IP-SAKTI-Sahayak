# IP-SAKTI Sahayak — backend configuration
#
# Copy to `backend/.env` and edit. `.env` is gitignored; nothing secret is
# committed. Every key is optional: with none of them set the API runs, serves
# the demo corpus, and says so on every answer.

# -- what this instance is ---------------------------------------------------
SAHAYAK_ENVIRONMENT=development
SAHAYAK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -- generation --------------------------------------------------------------
# "fixture" (default) answers only over demo passages and refuses to write over
# a real retrieved one. Set "anthropic" with a key to answer from a real corpus.
# Requires the "llm" extra: pip install -e "backend[llm]"
SAHAYAK_LLM_PROVIDER=fixture
# SAHAYAK_LLM_PROVIDER=anthropic
# SAHAYAK_LLM_API_KEY=
# SAHAYAK_LLM_MODEL=claude-opus-5

# -- translation -------------------------------------------------------------
# "passthrough" (default) returns the answer untranslated and says so.
# "bhashini" needs both a key and a pipeline id, or it falls back to passthrough.
SAHAYAK_TRANSLATOR=passthrough
# SAHAYAK_BHASHINI_API_KEY=
# SAHAYAK_BHASHINI_PIPELINE_ID=

# -- the corpus --------------------------------------------------------------
# Where the built index is read from. Point this at a build made somewhere else
# without moving it on top of the one in place — this is how the sample corpus
# from `make ingest-samples` is served.
# SAHAYAK_INDEX_DIR_OVERRIDE=data/index-samples

# Layer 2, in its own database. Records are evidence of what was filed; they are
# never embedded, never citable, and never in the same file as the corpus index.
# SAHAYAK_RECORDS_DB_OVERRIDE=data/records-samples.sqlite3
# SAHAYAK_RECORDS_MANIFEST_OVERRIDE=corpus/samples/records-manifest.json

# -- retrieval ---------------------------------------------------------------
# SAHAYAK_RETRIEVAL_CANDIDATES=30
# SAHAYAK_RERANK_KEEP=8
# SAHAYAK_CONTEXT_TOKEN_BUDGET=6000

# -- limits ------------------------------------------------------------------
# SAHAYAK_RATE_LIMIT_REQUESTS=30
# SAHAYAK_RATE_LIMIT_WINDOW_SECONDS=60
# SAHAYAK_MAX_REQUEST_BYTES=32768

# -- audit -------------------------------------------------------------------
# The audit log holds no question text, no answer text and no user identity.
# See backend/app/services/audit.py.
SAHAYAK_AUDIT_ENABLED=true
