# Copy to backend/.env and fill in. Never commit backend/.env.
SAHAYAK_ENVIRONMENT=development
SAHAYAK_DEBUG=true
SAHAYAK_HOST=127.0.0.1
SAHAYAK_PORT=8000
SAHAYAK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set by the corpus pipeline in Phase 11.
SAHAYAK_CORPUS_VERSION=0.0.0-unbuilt

# Phase 10 onwards. Absent until then; nothing calls a model yet.
SAHAYAK_LLM_API_KEY=
SAHAYAK_BHASHINI_API_KEY=
