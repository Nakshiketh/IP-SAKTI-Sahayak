# IP-SAKTI Sahayak — frontend configuration
#
# Copy to `frontend/.env.local` and edit. One variable decides whether the app
# talks to the API or answers from the demo fixture.
#
#   live  (default)  POST /api/v1/query, proxied to the backend in dev
#   mock             answer from data/fixtures with no backend running
#
# The test suite defaults to `mock`, because a component test asserting on
# rendering should not be asserting on a network.
VITE_SAHAYAK_API=live
